# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-electron/
build/
out/
release/
target/
*.tsbuildinfo

# electron-builder's buildResources dir (apps/desktop/build/) is a real
# source-asset directory (the app icon), not build output — exempted from
# the generic build/ ignore above (docs/sprints/SPRINT-10.md).
!apps/desktop/build/
apps/desktop/build/*
!apps/desktop/build/icon.ico

# Rust
**/target/
Cargo.lock

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Test artifacts
coverage/
playwright-report/
test-results/
.vitest-cache/

# Cache
.turbo/
.cache/

# Local user data (SQLite, analysis cache) written at runtime
*.sqlite
*.sqlite-journal
.flowscope/
